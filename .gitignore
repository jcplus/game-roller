*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
credentials*
secrets*
service-account*.json
oauth*.json

# Local databases and state
*.db
*.db-*
*.sqlite
*.sqlite3

# Hosting/provider configuration and generated state
.openai/
.vercel
.cloudflare/

